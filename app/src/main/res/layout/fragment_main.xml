<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:padding="16dp"
    tools:targetApi="q"
    android:forceDarkAllowed="false">

    <!-- Header Container -->
    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/badgeHiFi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:minWidth="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:paddingHorizontal="12dp"
            android:text="PRO"
            android:textColor="@color/accent_green"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnStreamingSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_toStartOf="@id/btnExitApp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tune"
            android:contentDescription="Settings"
            app:tint="@color/accent_green" />

        <ImageButton
            android:id="@+id/btnExitApp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Exit"
            app:tint="@color/accent_green" />

    </RelativeLayout>

    <!-- Main Footer (Bottom) -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWifiSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Wi-Fi: --"
                android:textColor="@color/accent_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvAudioFormatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="6dp"
                android:text="PCM 44.1kHz (Bit-Perfect)"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvReceiverHwBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="6dp"
                android:text="HW: --"
                android:textColor="@color/accent_green"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Section: Fixed Top Controls + Scrollable Saved Receivers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:layout_above="@id/footerContainer"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Main Button and Status (Fixed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="12dp">

            <!-- Pulsing Update Recommendation Chip -->
            <TextView
                android:id="@+id/btnUpdateAvailable"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_update_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🚀 UPDATE TERSEDIA: v1.2"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <FrameLayout
                android:id="@+id/buttonContainer"
                android:layout_width="220dp"
                android:layout_height="220dp">

                <View
                    android:id="@+id/viewVisualizer1"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/accent_green" />

                <View
                    android:id="@+id/viewGlow"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:alpha="0.1"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/accent_green" />

                <Button
                    android:id="@+id/btnToggleStream"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/accent_green"
                    android:elevation="6dp"
                    android:text="START"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:text="Siap untuk streaming"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Control Section (Fixed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/section_background"
            android:backgroundTint="#0DFFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etManualIpMain"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/section_background"
                    android:backgroundTint="#0DFFFFFF"
                    android:hint="Receiver IP"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="#4DFFFFFF"
                    android:textSize="15sp"
                    tools:targetApi="q"
                    android:forceDarkAllowed="false" />

                <Button
                    android:id="@+id/btnOkIp"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="@color/accent_green"
                    android:minWidth="80dp"
                    android:paddingHorizontal="16dp"
                    android:text="CONNECT"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScanQrMain"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:text="SCAN QR"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#1AFFFFFF"
                    app:strokeColor="#26FFFFFF"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btnHotspotMain"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:text="HOTSPOT"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#1AFFFFFF"
                    app:strokeColor="#26FFFFFF"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btnAutoDiscoverMain"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:text="AUTO DISCOVER"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#1AFFFFFF"
                    app:strokeColor="#26FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Saved Receivers Header Label (Fixed) -->
        <TextView
            android:id="@+id/tvSavedReceiversLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAVED RECEIVERS"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.1"
            android:alpha="0.9" />

        <!-- Scrollable Saved Receivers List Only -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/layoutSavedIps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp" />

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</RelativeLayout>
