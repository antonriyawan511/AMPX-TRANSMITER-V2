<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    android:paddingHorizontal="4dp">

    <!-- Master Volume (60%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvMasterVolumeLabel"
                style="@style/EqualizerCategoryTitle"
                android:layout_marginBottom="0dp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvMasterVolumeValue"
                android:singleLine="true"
                android:lines="1"
                android:text="@string/master_volume" />

            <TextView
                android:id="@+id/tvMasterVolumeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="100%"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:gravity="end|center_vertical"
                tools:text="100%" />
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <SeekBar
                android:id="@+id/seekBarMasterVolume"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/section_background"
                android:backgroundTint="#0DFFFFFF"
                android:max="100"
                android:paddingHorizontal="12dp"
                android:progress="100"
                android:progressTint="@color/accent_green"
                android:splitTrack="false"
                android:thumbTint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <Space
        android:layout_width="6dp"
        android:layout_height="wrap_content" />

    <!-- Volume Controls (40%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Hidden dummy IDs to ensure complete backward compatibility -->
        <TextView
            android:id="@+id/tvReceiverVolumeLabel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReceiverVolumeValue"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReceiverMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/pill_left"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnReceiverPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/pill_right"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="-1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>